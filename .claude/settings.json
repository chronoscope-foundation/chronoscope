{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just check)",
      "Bash(just check:*)",
      "Bash(just fmt)",
      "Bash(just fmt:*)",
      "Bash(just test)",
      "Bash(just test:*)",
      "Bash(just clippy)",
      "Bash(just clippy:*)",
      "Bash(just web-dev)",
      "Bash(just openapi)",
      "Bash(just corpus-hash)",
      "Bash(just corpus-test)",
      "Bash(just corpus-test-vlm)",
      "Bash(just fetch-weights)",
      "Bash(just fetch-corpus)",
      "Bash(just fetch-regions)",
      "Bash(just fetch-regions:*)",
      "Bash(just fetch-all)",
      "Bash(just --list)",
      "Bash(nix flake check)",
      "Bash(nix flake show:*)",
      "Bash(nix build .#:*)",
      "Bash(nix eval:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/precommit-check.sh"
          }
        ]
      }
    ]
  }
}
