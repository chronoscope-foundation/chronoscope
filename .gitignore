# Rust
target/
*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code
.claude/worktrees/
.claude/scheduled_tasks.lock
# Marker file written by `just check` on success; consumed by the
# pre-commit hook at .claude/hooks/precommit-check.sh
.claude/last-check.json

# macOS
.DS_Store

# Environment files (secrets)
.env
.env.local
.env.*.local

# SQLite databases
*.db
*.db-journal
*.db-shm
*.db-wal
/data/

# OpenAPI generated specs (regenerated on build)
openapi.json

# iOS / Xcode
ios/Chronoscope.xcodeproj/
ios/ChronoscopeAPI/.build/
ios/.build/
*.xcuserstate
xcuserdata/
DerivedData/

# Swift Package Manager
.swiftpm/
Packages/
Package.resolved

# Python
__pycache__/
.hypothesis/

# Trunk (web frontend build artifacts)
# NOTE: `web/dist/` is intentionally NOT ignored — `trunk serve` writes to
# `target/web-dist/` (configured in `web/Trunk.toml`) and tests read from
# `$WEB_DIST` (nix shell). If `web/dist/` ever appears, something regressed.
web/result
web/tailwind.css

# Nix
/result
/result-*
.direnv/
.nix-gc-roots/
