+impl RequantizeHandles {
+    /// Per-module receivers in input order. Consuming this drives the drain that keeps the
+    /// submit-side host-budget backpressure relievable.
+    pub fn receivers(&self) -> mpsc::Iter<'_, pending_layer::IsqReceiver> {
+        self.receivers.iter()
+    }
+}
+
+impl Drop for RequantizeHandles {
+    fn drop(&mut self) {
+        // A caller that stops early leaves the submitter parked on the host budget. Draining the
+        // rest releases each retained output, so the submitter finishes and the pool can join.
+        while let Ok(rx) = self.receivers.recv() {
+            let _ = rx.recv();
+        }
+        if let Some(submitter) = self.submitter.take() {
+            let _ = submitter.join();
+        }
+    }
+}
