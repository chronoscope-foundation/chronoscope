name: "vlm"
backend: "vllm"
max_batch_size: 0

input [
  {
    name: "text_input"
    data_type: TYPE_STRING
    dims: [-1]
  },
  {
    name: "image"
    data_type: TYPE_STRING
    dims: [-1]
    optional: true
  },
  {
    name: "sampling_parameters"
    data_type: TYPE_STRING
    dims: [-1]
    optional: true
  }
]

output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [-1]
  }
]

# Single instance - vLLM handles multi-GPU via tensor_parallel_size in model.json
instance_group [
  {
    count: 1
    kind: KIND_MODEL
  }
]
